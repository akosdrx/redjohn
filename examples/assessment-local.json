{
  "policy": {
    "engagement_id": "approved-local-lab",
    "owner_id": "local-operator",
    "revision": "1",
    "allowed_origins": ["http://127.0.0.1:3000"],
    "allowed_ips": ["127.0.0.1/32"],
    "target_domains": ["web"],
    "profile": "isolated-lab",
    "egress_mode": "local-fixture",
    "actor_ids": ["anonymous"],
    "request_budget": 128,
    "max_attempts": 2,
    "retry_budget": 4
  },
  "resources": {
    "total_memory_budget": 1073741824,
    "worker_memory_budget": 268435456,
    "browser_concurrency": 1,
    "max_workers": 2,
    "max_pages": 2,
    "max_contexts": 2,
    "cache_max_bytes": 33554432,
    "queue_max_items": 128,
    "artifact_max_bytes": 4194304,
    "max_model_input_tokens": 32768,
    "soft_watermark": 0.8,
    "high_watermark": 0.9,
    "resume_watermark": 0.65
  },
  "browser": {
    "max_pages": 8,
    "max_frontier": 32,
    "max_requests": 128,
    "readiness_selector": "body",
    "navigation_timeout_ms": 5000,
    "readiness_timeout_ms": 3000,
    "total_timeout_seconds": 30
  },
  "seeds": [
    {
      "url": "http://127.0.0.1:3000/",
      "actor_id": "anonymous",
      "session_revision": "1",
      "capabilities": ["browser_discover", "headers_audit", "nuclei_scan"]
    }
  ]
}
