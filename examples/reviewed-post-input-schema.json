{
  "openapi": "3.0.3",
  "info": {"title": "RedJohn reviewed API", "version": "1"},
  "paths": {
    "/input": {
      "post": {
        "operationId": "reviewedPostInput",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {"value": {"type": "integer", "minimum": 0, "maximum": 9}},
                "required": ["value"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reviewed response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {"id": {"type": "integer"}},
                  "required": ["id"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
