<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>RedJohn report — {{ run.name }}</title>
<style>
  body { font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; margin: 2rem; color: #1a1a1a; }
  h1, h2 { border-bottom: 1px solid #ddd; padding-bottom: .3rem; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .9rem; }
  th, td { border: 1px solid #ccc; padding: .35rem .6rem; text-align: left; vertical-align: top; }
  th { background: #f3f3f3; }
  .sev-critical { color: #8b0000; font-weight: bold; }
  .sev-high { color: #c0392b; }
  .sev-medium { color: #b9770e; }
  .sev-low { color: #1e8449; }
  .sev-info { color: #555; }
  .meta { color: #666; font-size: .85rem; }
  code { background: #f5f5f5; padding: .1rem .3rem; }
</style>
</head>
<body>
<h1>RedJohn pentest report</h1>
<p class="meta">Generated {{ generated_at }} · run <code>{{ run.run_id }}</code> · status
<strong>{{ run.status }}</strong> · environment {{ run.environment }}</p>

<h2>Run</h2>
<table>
  <tr><th>Name</th><td>{{ run.name }}</td></tr>
  <tr><th>Task</th><td>{{ run.task }}</td></tr>
  <tr><th>Scope version</th><td>{{ run.scope.version }} ({{ run.scope.allowed_targets | length }} targets,
      {{ run.scope.allowed_tools | length }} tools)</td></tr>
  <tr><th>Started</th><td>{{ run.started_at or "—" }}</td></tr>
  <tr><th>Finished</th><td>{{ run.finished_at or "—" }}</td></tr>
</table>

<h2>Findings ({{ findings | length }})</h2>
<table>
  <tr><th>Code</th><th>Severity</th><th>Status</th><th>Title</th><th>Target</th><th>Evidence</th></tr>
  {% for f in findings %}
  <tr>
    <td>{{ f.code }}</td>
    <td class="sev-{{ f.severity }}">{{ f.severity }}</td>
    <td>{{ f.status }}</td>
    <td>{{ f.title }}{% if f.description %}<br><span class="meta">{{ f.description }}</span>{% endif %}</td>
    <td>{{ f.target }}</td>
    <td>{{ f.evidence_refs | length }} item(s)</td>
  </tr>
  {% else %}
  <tr><td colspan="6">No findings recorded.</td></tr>
  {% endfor %}
</table>

<h2>Agents ({{ agents | length }})</h2>
<table>
  <tr><th>Name</th><th>Role</th><th>Depth</th><th>Status</th><th>Activity</th></tr>
  {% for a in agents %}
  <tr><td>{{ a.name }}</td><td>{{ a.role }}</td><td>{{ a.depth }}</td>
      <td>{{ a.status }}</td><td>{{ a.current_activity }}</td></tr>
  {% endfor %}
</table>

<h2>Evidence ({{ evidence | length }})</h2>
<table>
  <tr><th>ID</th><th>SHA-256</th><th>Size</th><th>Source</th></tr>
  {% for e in evidence %}
  <tr><td><code>{{ e.evidence_id }}</code></td><td><code>{{ e.sha256[:16] }}…</code></td>
      <td>{{ e.size_bytes }} B</td><td>{{ e.source }}</td></tr>
  {% endfor %}
</table>

<h2>Timeline ({{ timeline | length }} events)</h2>
<table>
  <tr><th>Seq</th><th>Type</th><th>Agent</th><th>Time</th></tr>
  {% for ev in timeline %}
  <tr><td>{{ ev.seq }}</td><td>{{ ev.type }}</td><td>{{ ev.agent_id or "" }}</td>
      <td>{{ ev.occurred_at }}</td></tr>
  {% endfor %}
</table>
</body>
</html>
