# CI-only policy. No executable attachment and no unconfined/complain mode.
# Root enters this named profile before setpriv drops to the runner UID.
# Every exec inherits confinement, including bwrap's no-new-privs children
# and Chromium's nested namespace/seccomp sandbox. Host capabilities remain 0.
abi <abi/4.0>,
include <tunables/global>
profile @REDJOHN_CI_PROFILE@ flags=(attach_disconnected,mediate_deleted) {
  # bwrap's setuid namespace setup plus setpriv's initial UID/GID drop.
  # The distro bwrap binary needs sys_admin to create the reviewed user/mount
  # namespaces and net_admin to configure loopback inside its new netns.
  # sys_ptrace remains absent.
  capability setuid,
  capability setgid,
  capability setpcap,
  capability sys_chroot,
  capability sys_admin,
  capability net_admin,

  # Read/execute system trees. Writes are limited to the runner's workspace,
  # package caches, temporary files and the delegated cgroup.
  / r,
  /{bin,etc,lib,lib32,lib64,sbin,usr}/** rix,
  # bwrap creates empty mountpoints in its private mount namespace. These
  # directory-only write rules do not grant writes to host files below them.
  /{bin,etc,lib,lib32,lib64,sbin,usr,proc,dev,tmp,run,sys,home,opt,var}/ w,
  /opt/** rix,
  /var/lib/dpkg/** r,
  /var/lib/apt/lists/** r,
  /var/cache/apt/** r,
  /home/*/work/** rwklix,
  /home/*/go/** rwklix,
  /home/*/.gitconfig r,
  /home/*/.bashrc r,
  /home/*/.profile r,
  /home/*/.cache/** rwklix,
  /home/*/.local/** rwklix,
  /home/*/.config/** rwklix,
  /home/*/.npm/** rwklix,
  /home/*/.yarn/** rwklix,
  /home/*/.pnpm-store/** rwklix,
  /home/*/.cargo/** rwklix,
  /home/*/.rustup/** rwklix,
  /home/*/.redjohn/** rwklix,
  /home/*/.m2/** rwklix,
  /home/*/.gradle/** rwklix,
  /home/*/.nuget/** rwklix,
  /home/*/.dotnet/** rwklix,
  /home/*/.gem/** rwklix,
  /tmp/** rwklix,
  /var/tmp/** rwklix,
  /run/** rwklix,
  /dev/** rwklix,
  /proc/** r,
  /proc/self/{uid_map,gid_map,setgroups} rw,
  /proc/[0-9]*/{uid_map,gid_map,setgroups} rw,
  /proc/sys/** r,
  /sys/** r,
  /sys/fs/cgroup/redjohn-ci-*/** rwklix,

  network,
  unix,
  signal,
  userns,
  mount,
  umount,
  pivot_root,

  audit deny /etc/apparmor.d/{,**} wkl,
  audit deny /proc/sys/{,**} w,
  audit deny /proc/sysrq-trigger w,
  audit deny /sys/kernel/security/{,**} wkl,
  audit deny /proc/{self,thread-self,[0-9]*}/attr/{current,exec} w,
}
