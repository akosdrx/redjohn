{
  "name": "redjohn-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "RedJohn desktop app (Electron) and shared UI package",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "schema:generate": "pnpm --filter @redjohn/app run schema:generate",
    "package": "pnpm build && pnpm --filter @redjohn/app run package",
    "clean": "pnpm -r exec rm -rf dist out"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "ws": "^8.22.0"
  }
}
