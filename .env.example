# RedJohn terminal client configuration (copy to .env or export in shell)

# --- Connection (highest precedence over server.json) ---
# Base URL of the local engine API (written by `redjohn serve` to server.json)
RJ_API_URL=http://127.0.0.1:8720/api/v1
# Bearer token for the loopback-authenticated engine
RJ_API_TOKEN=

# --- Profile / state directories ---
# Config profile name (selects ~/.redjohn/<profile>/)
REDJOHN_PROFILE=default
# Base directory for all RedJohn CLI state (config.json, server.json, exports)
REDJOHN_HOME=~/.redjohn

# --- Engine setup (consumed by `redjohn setup` / passed to the engine) ---
# Model provider for agents, e.g. anthropic
RJ_MODEL_PROVIDER=anthropic
RJ_MODEL_NAME=
# OpenViking server URL (skills/context runtime)
RJ_OPENVIKING_URL=http://127.0.0.1:1933
