# RedJohn environment configuration (copy to .env or export in your shell)

# --- Model routing ---
# Active model (e.g. openai/gpt-4o, a codex/ or xai/ subscription model, ...)
REDJOHN_LLM=
LLM_API_KEY=
LLM_API_BASE=

# --- Runtime sandbox ---
# "docker" (container sandbox) or "local" (host execution; on non-macOS the
# local backend additionally requires REDJOHN_ALLOW_UNCONFINED_LOCAL=1 to
# acknowledge host execution)
REDJOHN_RUNTIME_BACKEND=local
REDJOHN_IMAGE=ghcr.io/redjohn-ai/redjohn-sandbox:1.3.0
# REDJOHN_ALLOW_UNCONFINED_LOCAL=1

# --- OpenViking persistent memory (default: enabled, local workspace) ---
# REDJOHN_OPENVIKING_ENABLED=1
# REDJOHN_OPENVIKING_MODEL=
# REDJOHN_OPENVIKING_PROVIDER=
# REDJOHN_OPENVIKING_API_KEY=
# REDJOHN_OPENVIKING_API_BASE=
# REDJOHN_OPENVIKING_EMBEDDING_MODEL=
# REDJOHN_OPENVIKING_EMBEDDING_PROVIDER=
# REDJOHN_OPENVIKING_EMBEDDING_DIMENSION=
# REDJOHN_OPENVIKING_WORKSPACE=~/.redjohn/openviking/data
# External memory server: https-only, and requires explicit egress opt-in.
# OPENVIKING_URL=https://memory.example.com
# REDJOHN_OPENVIKING_ALLOW_REMOTE=1

# --- MCP connections ---
# Custom MCP servers (JSON list); default file: ~/.redjohn/mcp-servers.json
# REDJOHN_MCP_CONFIG=
# REDJOHN_MCP_ONLY=
# REDJOHN_MCP_EXCLUDE=

# --- Telemetry (default: disabled) ---
# REDJOHN_TELEMETRY=1
