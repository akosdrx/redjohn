{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redjohn-assessment-contract-v1",
  "$defs": {
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "family",
        "capability"
      ],
      "properties": {
        "surface_id": {
          "type": "string",
          "maxLength": 128
        },
        "family": {
          "type": "string",
          "maxLength": 128
        },
        "capability": {
          "type": "string",
          "maxLength": 128
        },
        "tool_version": {
          "type": "string",
          "maxLength": 128
        },
        "template_version": {
          "type": "string",
          "maxLength": 128
        },
        "profile_version": {
          "type": "string",
          "maxLength": 128
        },
        "policy_revision": {
          "type": "string",
          "maxLength": 128
        },
        "retest_revision": {
          "type": "string",
          "maxLength": 128
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "idempotent": {
          "type": "boolean"
        },
        "priority": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "options": {
          "type": "object",
          "description": "Per-adapter allowlist: empty for browser/HTTP; cve_id only for reviewed Nuclei"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_status",
        "coverage_status",
        "summary",
        "findings",
        "error"
      ],
      "properties": {
        "execution_status": {
          "enum": [
            "queued",
            "running",
            "retry_wait",
            "succeeded",
            "failed",
            "cancelled",
            "timed_out",
            "resource_exhausted"
          ]
        },
        "coverage_status": {
          "enum": [
            "not_tested",
            "completed",
            "partial",
            "blocked",
            "unsupported",
            "inconclusive"
          ]
        },
        "summary": {
          "type": "object"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "finding_status": {
                "enum": [
                  "candidate",
                  "confirmed_weakness",
                  "confirmed_impact",
                  "false_positive",
                  "fixed",
                  "reopened"
                ]
              }
            }
          }
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "category",
        "message",
        "retryable",
        "terminal",
        "job_id",
        "attempt_id",
        "tool_id",
        "cause_ref",
        "retry_after",
        "partial_evidence_refs",
        "coverage_effect",
        "recovery_action"
      ],
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cause_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "coverage_effect": {
          "type": [
            "string",
            "null"
          ]
        },
        "recovery_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "terminal": {
          "type": "boolean"
        },
        "retry_after": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "partial_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    },
    "browser_tls_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstream_ca_file": {
          "type": [
            "string",
            "null"
          ],
          "description": "Explicit local-lab PEM CA path; strict chain and hostname validation remain enabled."
        }
      }
    },
    "persisted_rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "description": "Internal additive rj_rate_limit row; UTC seconds, hashed scope or one global-cooldown control row. Not a public credential API.",
      "required": [
        "engagement",
        "scope",
        "window_until",
        "requests",
        "cooldown_until",
        "expires_at"
      ],
      "properties": {
        "engagement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "window_until": {
          "type": "number",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "cooldown_until": {
          "type": "number",
          "minimum": 0
        },
        "expires_at": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "description": "Documented contract. Runtime dataclass/API validation additionally enforces terminal adapter states and policy/access/size invariants."
}
